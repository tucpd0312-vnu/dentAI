# ── Python cache ─────────────────────────────────────────────────────────────
**/__pycache__/
**/*.pyc
**/*.pyo
*.egg-info/

# ── Node ─────────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/

# ── Django runtime / DB ───────────────────────────────────────────────────────
backend/db.sqlite3
backend/media/
backend/scans_storage/

# ── Env / IDE ─────────────────────────────────────────────────────────────────
# **/.env cần thiết: `COPY backend/ .` sẽ nướng backend/.env (SMTP password)
# vào layer image nếu chỉ ignore `.env` ở root.
**/.env
.env
.venv/
.ruff_cache/
.pytest_cache/

# ── Git / CI / claude ─────────────────────────────────────────────────────────
.git/
.gitignore
.claude/
.codegraph/

# ── Conda export (không cần trong image) ─────────────────────────────────────
environment.worker.yml
