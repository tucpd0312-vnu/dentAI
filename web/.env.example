# Copy sang web/.env (file .env KHÔNG commit vào git).
# Secret hạ tầng dùng chung cho docker-compose (thay thế ${VAR} trong docker-compose.yml).
# Secret riêng của Django (SMTP) nằm ở backend/.env — xem backend/.env.example.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=dentai
POSTGRES_USER=dentai
POSTGRES_PASSWORD=dentai

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# ── Tài khoản quản trị khởi tạo ───────────────────────────────────────────────
# `manage.py seed_admin` chạy tự động sau migrate. Idempotent: chạy lại không tạo
# trùng và KHÔNG ghi đè mật khẩu (dùng `seed_admin --force-password` nếu muốn reset).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@dentai.local
SEED_ADMIN_PASSWORD=Admin@123
