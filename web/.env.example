# Copy sang web/.env (file .env KHÔNG commit vào git).
# Secret hạ tầng dùng chung cho docker-compose (thay thế ${VAR} trong docker-compose.yml).
# Secret riêng của Django (SMTP) nằm ở backend/.env — xem backend/.env.example.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=dentai
POSTGRES_USER=dentai
POSTGRES_PASSWORD=dentai

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# ── Tài khoản quản trị khởi tạo ───────────────────────────────────────────────
# `manage.py seed_admin` chạy tự động sau migrate. Idempotent: chạy lại không tạo
# trùng và KHÔNG ghi đè mật khẩu (dùng `seed_admin --force-password` nếu muốn reset).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@dentai.local
SEED_ADMIN_PASSWORD=Admin@123

# ── Sinh mô tả lâm sàng ─────────────────────────────────────────────────────
# auto: có checkpoint T5 thì dùng T5, thiếu/hỏng thì tự dùng luật (khuyến nghị).
# rule: luôn dùng luật. t5: bắt buộc T5 và báo lỗi nếu checkpoint chưa đầy đủ.
CAPTION_MODE=auto
# Docker mặc định tự dùng /inferences/t5_training/t5_gingivitis_model.
# Chỉ bỏ comment khi cần trỏ đến một thư mục checkpoint khác bên trong container.
# T5_MODEL_DIR=/inferences/t5_training/t5_gingivitis_model
# auto, cpu, cuda, cuda:0 hoặc số GPU (ví dụ 0).
T5_DEVICE=auto
