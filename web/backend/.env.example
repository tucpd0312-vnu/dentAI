# Copy sang backend/.env (file .env KHÔNG commit vào git).
# File này chỉ chứa secret riêng của Django container (SMTP).
# Secret hạ tầng dùng chung (DB password, SECRET_KEY, SEED_ADMIN_*) nằm ở
# ../.env — xem ../.env.example.
# Các biến không bí mật nằm trong docker-compose.yml (x-django-env).

# ── SMTP (gửi OTP xác thực email) ────────────────────────────────────────────
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=no-reply@gmail.com